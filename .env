# 应用标题
VITE_APP_TITLE=Madong 极速开发框架

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=madong-single

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key


# 是否启用离线图标（true=使用本地 @iconify/json，避免在线图标 API 不可达时页面挂起）
VITE_APP_ICON_OFFLINE=true

# 是否启用本地 Nitro mock 服务（true=无后端运行，接口走 5320 mock；false=走真实后端 8500）
VITE_NITRO_MOCK=true

# 租户运行模式【 auto 探测后端 / standard 强制标准版 / saas 强制多租户 】
# 不设定时默认 auto：请求 /auth/tenant-mode 由后端决定是否开启租户
# standard：强制标准版，完全不请求租户模式接口（后端无该接口时推荐，省一次 404）
# saas：强制多租户，完全不请求租户模式接口，直接开启租户搜索/切换
# 使用 VITE_GLOB_ 前缀：生产构建注入 _app.config.js，部署后可直接改该文件切换，无需重新构建
VITE_GLOB_TENANT_MODE=standard
